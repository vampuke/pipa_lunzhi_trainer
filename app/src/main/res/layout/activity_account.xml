<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/account_back" android:textColor="@color/brand_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/account_title" android:textColor="@color/text_primary"
            android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <ProgressBar android:id="@+id/accountProgress" android:layout_width="32dp"
                    android:layout_height="32dp" android:layout_gravity="center_horizontal"
                    android:indeterminateTint="@color/brand_text" android:visibility="gone"
                    android:contentDescription="@string/account_working" />
                <TextView android:id="@+id/accountMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                    android:textColor="@color/bad" android:textSize="14sp"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />

                <LinearLayout android:id="@+id/guestPanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/authMode" android:layout_width="match_parent"
                        android:layout_height="wrap_content" app:singleSelection="true"
                        app:selectionRequired="true" app:checkedButton="@id/loginMode">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loginMode" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/account_login"
                            android:textColor="@color/brand_text" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/registerMode" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/account_register"
                            android:textColor="@color/brand_text" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView android:id="@+id/formHint" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                        android:text="@string/account_login_hint" android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/App.TextField" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="@string/account_username">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/usernameInput" style="@style/App.TextInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textVisiblePassword" android:maxLines="1" android:maxLength="64"
                            android:autofillHints="username" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/recoveryInputLayout" style="@style/App.TextField"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="@string/account_recovery_code"
                        android:visibility="gone">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/recoveryInput" style="@style/App.TextInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textVisiblePassword" android:maxLines="1" android:maxLength="128"
                            android:saveEnabled="false" android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout" style="@style/App.TextField"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="@string/account_password"
                        app:endIconMode="password_toggle" app:endIconTint="@color/text_secondary"
                        app:endIconContentDescription="@string/account_toggle_password">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordInput" style="@style/App.TextInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textPassword" android:maxLines="1" android:maxLength="128"
                            android:saveEnabled="false" android:autofillHints="password" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/App.TextField" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:hint="@string/account_device_name">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/deviceNameInput" style="@style/App.TextInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textCapSentences" android:maxLines="1" android:maxLength="80" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submitAuth" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="@string/account_login" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recoverAccount" style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/account_recover" android:textColor="@color/brand_text" />
                </LinearLayout>

                <LinearLayout android:id="@+id/recoveryPanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/account_recovery_title" android:textColor="@color/text_primary"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/account_recovery_notice"
                        android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/recoveryCode" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
                        android:padding="16dp" android:background="@color/surface_variant"
                        android:textColor="@color/text_primary" android:fontFamily="monospace"
                        android:textSize="16sp" android:textIsSelectable="true" android:saveEnabled="false" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/recoverySaved" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/account_recovery_saved"
                        android:textColor="@color/text_primary" app:buttonTint="@color/brand_text"
                        app:buttonIconTint="@color/surface" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/continueAccount" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:enabled="false"
                        android:text="@string/account_continue" />
                </LinearLayout>

                <LinearLayout android:id="@+id/profilePanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/profileUsername" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/brand_text"
                        android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/sessionExpiry" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/lastSync" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/syncStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:accessibilityLiveRegion="polite" />
                    <TextView android:id="@+id/localOnlyNote" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/account_local_only"
                        android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/syncNow" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/account_sync_now" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changePassword" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/account_change_password" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/regenerateRecovery" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/account_regenerate_recovery" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/logout" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/account_logout" android:textColor="@color/brand_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/account_privacy_note"
            android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
