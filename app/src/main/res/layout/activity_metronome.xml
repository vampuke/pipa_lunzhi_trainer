<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BPM 显示卡 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bpmCard"
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="20dp"
                android:paddingBottom="22dp">

                <!-- 节拍指示灯：圆点由代码按模式动态生成（4 整拍 / 8 分拍 / 5 轮指） -->
                <LinearLayout
                    android:id="@+id/beatDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/bpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80"
                    android:textSize="76sp"
                    android:textStyle="bold"
                    android:textColor="@color/pipa_primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metro_bpm"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 微调 −/+ 与 SeekBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/metro_minus"
                android:textSize="26sp" />

            <SeekBar
                android:id="@+id/seekBpm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="180"
                android:progress="60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/metro_plus"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- 常用速度快捷按钮（80~100） -->
        <TextView
            style="@style/App.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/metro_presets" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/presetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset80"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="80" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset85"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="85" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset90"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="90" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset95"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="95" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset100"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="100" android:textSize="15sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 拍型：四分整拍 / 八分分拍 -->
        <TextView
            style="@style/App.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/metro_mode" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.vampuck.pipa_trainer.view.SymbolButton
                android:id="@+id/btnQuarter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:contentDescription="@string/metro_quarter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />
            <com.vampuck.pipa_trainer.view.SymbolButton
                android:id="@+id/btnEighth"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:contentDescription="@string/metro_eighth"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />
            <com.vampuck.pipa_trainer.view.SymbolButton
                android:id="@+id/btnLunzhi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:contentDescription="@string/metro_lunzhi"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 重音：强调首拍 / 四拍相同 -->
        <TextView
            style="@style/App.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/metro_accent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/accentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccentFirst"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/metro_accent_first" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccentSame"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/metro_accent_same" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 声音快捷开关（开始 / 停止） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMetroToggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/metro_start"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/metro_hint"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
