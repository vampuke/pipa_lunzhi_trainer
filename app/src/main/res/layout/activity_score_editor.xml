<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 实时预览 -->
    <TextView
        style="@style/App.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:text="@string/editor_preview" />

    <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp">

        <ScrollView
            android:id="@+id/previewScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp">

            <com.vampuck.pipa_trainer.view.JianpuView
                android:id="@+id/jianpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/editorCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <!-- 可滚动的编辑面板 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 音级 1-7 -->
            <TextView style="@style/App.SectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/editor_degree" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/d1" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d2" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d3" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d4" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d5" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d6" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="6" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/d7" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
            </LinearLayout>

            <!-- 八度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <TextView style="@style/App.SectionLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/editor_octave" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/octDown" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:textSize="20sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" />
                <TextView android:id="@+id/octLabel" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pipa_primary_dark" />
                <com.google.android.material.button.MaterialButton android:id="@+id/octUp" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:textSize="20sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" />
            </LinearLayout>

            <!-- 时值 -->
            <TextView style="@style/App.SectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/editor_duration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/dur16" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="16" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dur8" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="8" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dur4" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dur2" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/durDot2" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2." android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dur1" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/editor_dur_hint"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <!-- 指法 -->
            <TextView style="@style/App.SectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/editor_fingering" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/fingerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 每小节拍数 -->
            <TextView style="@style/App.SectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/editor_bpb" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/bpbGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/bpb2" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2/4" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bpb3" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3/4" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bpb4" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4/4" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="2"
                    android:text="@string/editor_add" android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/editor_rest" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackspace"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/editor_backspace" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/editor_clear" />
            </LinearLayout>

            <!-- 元信息 -->
            <TextView style="@style/App.SectionLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/editor_meta" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTitle"
                style="@style/App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/editor_hint_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTitle"
                    style="@style/App.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/App.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/editor_hint_key">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputKey"
                        style="@style/App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/App.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:hint="@string/editor_hint_bpm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBpm"
                        style="@style/App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/App.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/editor_hint_section">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputSection"
                        style="@style/App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/App.TextField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:hint="@string/editor_hint_diff">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDiff"
                        style="@style/App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/editor_hint_blurb">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBlurb"
                    style="@style/App.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="@string/editor_save" android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/import_copyright"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
