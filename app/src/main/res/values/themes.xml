<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PipaTrainer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/pipa_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- 次色（暖棕）-->
        <item name="colorSecondary">@color/pipa_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>

        <!-- 表面 / 背景 -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <!-- 系统栏 -->
        <item name="android:statusBarColor">@color/pipa_primary_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- 组件默认样式 -->
        <item name="materialButtonStyle">@style/App.Button</item>
        <item name="materialCardViewStyle">@style/App.Card</item>
    </style>

    <!-- 实心主按钮：16dp 圆角、略高、字距舒展 -->
    <style name="App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/App.Shape.Button</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="App.Shape.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- 输入框：与卡片同一套暖色描边（未聚焦时 @color/outline，聚焦/悬停转红木主色）。
         提示文字走 M3 描边框的标准 label 行为：空时落在框内，聚焦或有内容后浮到边框上。 -->
    <style name="App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/field_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/pipa_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="errorTextColor">@color/bad</item>
    </style>

    <!-- 输入框内的文字外观：正文色、14sp，与「卡片 + 说明」的层级一致。 -->
    <style name="App.TextInput" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 统一卡片外观：四边均匀的细描边。
         原来用 1dp 投影（Widget.Material3.CardView.Elevated），但 1dp 的「点投影」在浅色背景上
         只在卡片**下方**压出一条硬边，左右/上方几乎看不到——截图上就是「卡片像只有下边框」，
         看起来别扭。改成 M3 描边卡片：没有投影，四边同一条 outline 色细线。 -->
    <style name="App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 区块小标题 -->
    <style name="App.SectionLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
</resources>
