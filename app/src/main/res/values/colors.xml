<resources>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF231A16</color>

    <!-- 品牌主色：琵琶红木 -->
    <color name="pipa_primary">#FF8C3A2B</color>
    <color name="pipa_primary_dark">#FF5E271E</color>
    <!-- 点睛：丝弦金（替换原来的浅橙 accent） -->
    <color name="pipa_accent">#FFC8973F</color>
    <color name="pipa_accent_dark">#FF9A6E26</color>

    <!--
        品牌色分「用途」两份，深浅模式各自取合适的明度：
        pipa_primary* 当**填充**（头部渐变、主按钮、图表柱子），上面压白字；
        brand_text*   当**文字/图标**（标题、数值、强调），要保证压在页面底色上可读。
        两者在浅色模式同值，深色模式必须分开——同一个值没法既当深底填充又当浅色文字。
    -->
    <color name="brand_text">#FF8C3A2B</color>
    <color name="brand_text_strong">#FF5E271E</color>
    <!-- 金色胶囊里的文字 -->
    <color name="accent_chip_text">#FF7A5417</color>

    <!-- Material 3 容器 / 表面 token（暖木 + 宣纸米白） -->
    <color name="primary_container">#FFF7DED4</color>
    <color name="on_primary_container">#FF3A1710</color>
    <color name="accent_container">#FFF6E7CC</color>
    <color name="surface">#FFFFFBF8</color>
    <color name="surface_variant">#FFF2E8DF</color>
    <color name="outline">#FFE3D6CA</color>
    <color name="text_primary">#FF231A16</color>
    <color name="text_secondary">#FF7A6A60</color>

    <!-- 评价色（已按 WCAG 调深，白字可读） -->
    <color name="good">#FF1C7D45</color>
    <color name="warn">#FF8A6400</color>
    <color name="bad">#FFC62F2F</color>
    <!-- 评价色「填充块」版：用于底色上压白字（评分卡、维度徽标）。两种模式都保持
         足够深，白字对比度 ≥4.5。深色模式不要用提亮版，否则白字在亮底上糊成一片。 -->
    <color name="good_fill">#FF1C7D45</color>
    <color name="warn_fill">#FF8A6400</color>
    <color name="bad_fill">#FFC62F2F</color>
    <color name="chart_line">#FF2255CC</color>
    <!-- 起音散点 -->
    <color name="chart_onset">#FF9933DD</color>

    <color name="bg">#FFF6F1EA</color>

    <!-- 开始前倒数覆盖层（半透明，盖在谱面上） -->
    <color name="countdown_scrim">#F2FFFBF8</color>
    <!-- 节拍器熄灭的指示圆点 -->
    <color name="metro_dot_off">#FFE0D2C6</color>
</resources>
